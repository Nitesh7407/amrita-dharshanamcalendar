# Database connection string (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Admin Authentication Secret
JWT_SECRET="replace-with-a-secure-random-secret"

# Default Admin Credentials for Initial Database Seed
ADMIN_DEFAULT_EMAIL="admin@example.edu"
ADMIN_DEFAULT_PASSWORD="ChangeThisPassword123!"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
